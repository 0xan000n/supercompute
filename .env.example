# §61 — local | demo | production. Only `local` returns policy debug detail.
CTN_ENV=local

COORDINATOR_PORT=4200
TEE_PORT=4400
MOCK_PROVIDER_PORT=4300
TEE_URL=http://127.0.0.1:4400
MOCK_PROVIDER_URL=http://127.0.0.1:4300

# §20 — enclave egress allowlist, host:port. Providers are always allowed; the
# local mock provider must be listed explicitly so the allowlist stays meaningful.
CTN_EGRESS_ALLOWLIST=127.0.0.1:4300

# Models the cost of real zkVM proving so §66 can be measured. Labelled as a
# simulated cost everywhere it surfaces — never presented as a measured proof time.
CTN_SIMULATED_PROVING_MS=2400
CTN_SIMULATED_PROVING_JITTER_MS=700

# §18 — how long a 429'd credential sits out.
CTN_COOLDOWN_MS=60000
CTN_PROVIDER_TIMEOUT_MS=20000

NEXT_PUBLIC_COORDINATOR_URL=http://127.0.0.1:4200
